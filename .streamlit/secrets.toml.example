# Rename this file to secrets.toml and fill in your values.
# On Streamlit Cloud: App settings → Secrets → paste this content.
# NEVER commit secrets.toml to Git.

# ── Google Sheets (for human evaluation data collection) ──────────────────────
# 1. Create a Google Sheet named "SmartViz_HumanEval"
# 2. Share it (Editor access) with the client_email below
# 3. Copy the Sheet ID from the URL: docs.google.com/spreadsheets/d/SHEET_ID/

[gsheets]
spreadsheet_id = "PASTE_YOUR_GOOGLE_SHEET_ID_HERE"

[gcp_service_account]
type                        = "service_account"
project_id                  = "your-project-id"
private_key_id              = "key-id"
private_key                 = "-----BEGIN RSA PRIVATE KEY-----\nYOUR KEY\n-----END RSA PRIVATE KEY-----\n"
client_email                = "smartviz@your-project.iam.gserviceaccount.com"
client_id                   = "123456789"
auth_uri                    = "https://accounts.google.com/o/oauth2/auth"
token_uri                   = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url        = "https://www.googleapis.com/robot/v1/metadata/x509/smartviz%40your-project.iam.gserviceaccount.com"
